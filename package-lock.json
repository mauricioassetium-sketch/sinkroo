{
  "name": "sinkroo",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sinkroo",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=18.0.0"
      }
    },
    "node_modules/@sinkroo/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@sinkroo/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/@sinkroo/gaia": {
      "resolved": "packages/gaia",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/core": {
      "name": "@sinkroo/core",
      "version": "0.1.0",
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/engine": {
      "name": "@sinkroo/engine",
      "version": "0.1.0",
      "dependencies": {
        "@sinkroo/core": "0.1.0"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    },
    "packages/gaia": {
      "name": "@sinkroo/gaia",
      "version": "0.1.0",
      "dependencies": {
        "@sinkroo/core": "0.1.0",
        "@sinkroo/engine": "0.1.0"
      },
      "devDependencies": {
        "typescript": "^5.5.0"
      }
    }
  }
}
