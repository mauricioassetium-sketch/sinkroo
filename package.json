{
  "name": "sinkroo",
  "version": "0.1.0",
  "private": true,
  "description": "Sinkroo — plataforma de pre-validación de anuncios con enjambres de agentes orquestados por GAIA",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "verify": "node scripts/verify-engine.mjs && node scripts/verify-gaia.mjs",
    "migrate": "node scripts/migrate.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1"
  }
}
