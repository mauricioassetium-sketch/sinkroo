# ============================================================
# GAIA Broker — capa conectora de IA
# El broker usa el PRIMER provider configurado en este orden de prioridad:
#   1) GAIA_ENDPOINT_URL  (endpoint real de GAIA-orijins, cuando exista)
#   2) PROVIDER_BASE_URL  (cualquier LLM compatible chat-completions)
#   3) fallback local     (determinista, siempre operativo)
# ============================================================

# --- Opción 1: endpoint real de GAIA-orijins (futuro) ---
#GAIA_ENDPOINT_URL=https://gaia.orijins.app/v1
#GAIA_MODEL=gaia-sinkroo
#GAIA_API_KEY=tu-key-orijins

# --- Opción 2: LLM chat-completions (gratis o de pago) ---
# Ejemplos (descomenta una):
# Gemini (Google AI Studio, capa gratuita):
#   PROVIDER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   PROVIDER_MODEL=gemini-2.0-flash
#   PROVIDER_API_KEY=AIza...
#   PROVIDER_AUTH=Bearer
#
# Groq (capa gratuita):
#   PROVIDER_BASE_URL=https://api.groq.com/openai/v1
#   PROVIDER_MODEL=llama-3.3-70b-versatile
#   PROVIDER_API_KEY=gsk_...
#   PROVIDER_AUTH=Bearer
#
# OpenAI:
#   PROVIDER_BASE_URL=https://api.openai.com/v1
#   PROVIDER_MODEL=gpt-4o-mini
#   PROVIDER_API_KEY=sk-...
#   PROVIDER_AUTH=Bearer
PROVIDER_BASE_URL=
PROVIDER_MODEL=
PROVIDER_API_KEY=
PROVIDER_AUTH=Bearer

# Puerto del broker
PORT=3100
