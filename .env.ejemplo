# Plantilla de claves — copiar a .env.local y pegar los valores.
#
# Cómo se usa:
#   cp .env.ejemplo .env.local
#   (editar .env.local y pegar cada valor)
#
# .env.local NO se sube al repositorio (ya está en .gitignore). Las claves viven sólo en el servidor:
# no se guardan en la base, no viajan al navegador y no se muestran nunca en el panel.
#
# Lo que todavía no tengas, dejalo vacío o comentado: el panel dirá que falta configurar esa red y no
# ofrecerá un botón que no pueda funcionar. Nada se inventa.

# ---- 1 · Instagram + Meta Ads (una sola app de Meta) -------------------------------
# developers.facebook.com → Mis apps → crear app tipo Negocio → Configuración → Básica
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# ---- 2 · WhatsApp Cloud API (misma app de Meta) ------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# El secreto de la app de Meta (Configuración → Básica → Clave secreta de la app). Con esto se comprueba
# la FIRMA de cada mensaje que entra por el webhook.
# HACEN FALTA LOS DOS (el verify token y el secreto de la app): si falta alguno, el webhook NO atiende
# nada y responde 503. Antes, cuando faltaban, se saltaba la comprobación «para probar en local» y
# cualquiera podía hacerse pasar por Meta y meter conversaciones en la base a nombre de un negocio.
WHATSAPP_APP_SECRET=

# ---- 3 · TikTok --------------------------------------------------------------------
# developers.tiktok.com → Manage apps → Login Kit for Web + Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ---- 4 · YouTube + Google ----------------------------------------------------------
# console.cloud.google.com → habilitar YouTube Data API v3 y YouTube Analytics API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
GOOGLE_REDIRECT_URI=

# ---- 5 · Tienda (Shopify o WooCommerce) --------------------------------------------
# WooCommerce: TIENDA_TOKEN con el formato llave:secreto
TIENDA_URL=
TIENDA_TOKEN=
TIENDA_TIPO=

# ---- 6 · Píxel del sitio -----------------------------------------------------------
PIXEL_ID=
PIXEL_TOKEN=

# ---- 7 · Correo: el de los informes, la bienvenida y los avisos --------------------
# Con qué sale el correo. Hay dos caminos y con uno alcanza:
#   a) Resend (lo más simple): la clave de la API. Verifica el dominio de envío en resend.com.
#   b) Un servidor SMTP propio: el host (y el puerto). SMTP_USER y SMTP_PASS sólo si ese servidor
#      pide autenticación; SMTP_PORT por defecto es 587 y SMTP_SEGURO=1 es para el 465 (TLS directo).
# EMAIL_FROM es el remitente: sin él no se manda nada (tiene que ser un correo del dominio verificado).
# Si nada de esto está cargado, el producto NO dice que envió: registra el intento en la tabla
# «correos_enviados» con su motivo y el panel lo muestra. La bienvenida, la confirmación del correo, los
# avisos de conexión y el restablecer el PIN de seguridad salen por acá.
RESEND_API_KEY=
EMAIL_FROM=
# Si se usa SMTP en vez de Resend:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# 1 = TLS directo desde el primer byte (el 465 de siempre). Con el puerto 465 ya se asume.
SMTP_SEGURO=
# 1 = subir a TLS después del saludo (el 587 de siempre). Con el puerto 587 ya se asume.
SMTP_STARTTLS=

# APP_URL es la dirección pública del panel, la que va en los enlaces que salen por correo (confirmar el
# correo de la cuenta y restablecer el PIN). Ejemplo: https://app.sinkroo.com
# Si queda vacía se usa la primera dirección declarada en CORS_ORIGENES; si tampoco hay, el enlace del
# correo sale relativo y no sirve desde el correo: por eso conviene cargarla.
APP_URL=

# ---- 8 · bundle.social (publicar sin montar la app de cada plataforma) --------------
# bundle.social → Developers → API key del equipo. Esa clave se manda en la cabecera x-api-key.
# Con el plan de bundle NO hay analítica: esta conexión sirve para publicar, no para medir.
#
# Cada negocio conecta SUS cuentas: el servidor crea un equipo de bundle por negocio (POST /team) y ahí
# autoriza lo suyo, así nadie ve las cuentas de otro. El único caso especial es el suyo: su equipo ya
# existe y ya tiene cuentas conectadas.
BUNDLE_API_KEY=
# Dirección pública del panel a la que vuelve el negocio al terminar de conectar (la pantalla de bundle
# redirige ahí y el panel avisa con POST /api/integraciones/:red/confirmar para dejar la conexión anotada).
# Si queda vacía se usa la primera dirección de CORS_ORIGENES; si tampoco hay, la pantalla de bundle cierra
# sola y no se redirige a ninguna parte.
BUNDLE_REDIRECT_URL=
# Opcional, sólo si quiere fijar a mano cuál es SU equipo de bundle (el que ya tiene sus cuentas):
#   BUNDLE_NEGOCIO_DUENO = el id del negocio dueño (el de su cuenta en Sinkroo)
#   BUNDLE_TEAM_DUENO    = el id del equipo de bundle que le corresponde (si se deja vacío, el más antiguo)
# Normalmente NO hacen falta: el servidor reconoce su equipo porque lo creó el correo de su usuario en
# bundle.social. Se declaran sólo si quiere forzar otro equipo.
BUNDLE_NEGOCIO_DUENO=
BUNDLE_TEAM_DUENO=

# ---- 9 · El servidor propio: por dónde escucha y quién puede hablarle --------------
# El back escucha SÓLO en la vuelta local (127.0.0.1) y nginx es la única puerta. Así no queda un puerto
# propio abierto a internet: sin TLS, sin las cabeceras que pone nginx y sin nada que filtre lo que manda
# el cliente. En Docker se deja 0.0.0.0, porque los contenedores tienen que verse entre sí.
HOST=127.0.0.1
# El único proxy en el que se cree para saber la IP de quien pide (de eso dependen los frenos de
# intentos). Cualquier otra cabecera la escribe el cliente, así que no se le cree a ninguna.
PROXY_CONFIABLE=127.0.0.1
# Los orígenes que pueden hablarle al back desde un navegador, separados por coma. Si queda vacío se
# toma como «cualquiera» (abierto), que es cómodo en desarrollo y peligroso en producción.
CORS_ORIGENES=https://panel.sinkroo.com,https://sinkroo.com,https://www.sinkroo.com
# Clave con la que se CIFRAN los tokens de las cuentas conectadas (Instagram, Google, TikTok…) dentro de
# la base. Se genera una vez, larga y al azar:   openssl rand -base64 48
# Si se pierde, esos tokens dejan de poder leerse y hay que volver a conectar las cuentas: guárdela junto
# a las demás claves. Si queda vacía, los tokens se guardan SIN CIFRAR (y el servidor lo avisa al
# arrancar): un respaldo de la base entregaría las cuentas de los clientes.
DATOS_CLAVE=
