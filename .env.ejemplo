# Plantilla de claves — copiar a .env.local y pegar los valores.
#
# Cómo se usa:
#   cp .env.ejemplo .env.local
#   (editar .env.local y pegar cada valor)
#
# .env.local NO se sube al repositorio (ya está en .gitignore). Las claves viven sólo en el servidor:
# no se guardan en la base, no viajan al navegador y no se muestran nunca en el panel.
#
# Lo que todavía no tengas, dejalo vacío o comentado: el panel dirá que falta configurar esa red y no
# ofrecerá un botón que no pueda funcionar. Nada se inventa.

# ---- 1 · Instagram + Meta Ads (una sola app de Meta) -------------------------------
# developers.facebook.com → Mis apps → crear app tipo Negocio → Configuración → Básica
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# ---- 2 · WhatsApp Cloud API (misma app de Meta) ------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# ---- 3 · TikTok --------------------------------------------------------------------
# developers.tiktok.com → Manage apps → Login Kit for Web + Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# ---- 4 · YouTube + Google ----------------------------------------------------------
# console.cloud.google.com → habilitar YouTube Data API v3 y YouTube Analytics API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
GOOGLE_REDIRECT_URI=

# ---- 5 · Tienda (Shopify o WooCommerce) --------------------------------------------
# WooCommerce: TIENDA_TOKEN con el formato llave:secreto
TIENDA_URL=
TIENDA_TOKEN=
TIENDA_TIPO=

# ---- 6 · Píxel del sitio -----------------------------------------------------------
PIXEL_ID=
PIXEL_TOKEN=

# ---- 7 · Correo de los informes ----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
# Si se usa SMTP en vez de Resend:
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# ---- 8 · bundle.social (publicar sin montar la app de cada plataforma) --------------
# bundle.social → Developers → API key del equipo. Esa clave se manda en la cabecera x-api-key.
# Con el plan de bundle NO hay analítica: esta conexión sirve para publicar, no para medir.
#
# Cada negocio conecta SUS cuentas: el servidor crea un equipo de bundle por negocio (POST /team) y ahí
# autoriza lo suyo, así nadie ve las cuentas de otro. El único caso especial es el suyo: su equipo ya
# existe y ya tiene cuentas conectadas.
BUNDLE_API_KEY=
# Dirección pública del panel a la que vuelve el negocio al terminar de conectar (la pantalla de bundle
# redirige ahí y el panel avisa con POST /api/integraciones/:red/confirmar para dejar la conexión anotada).
# Si queda vacía se usa la primera dirección de CORS_ORIGENES; si tampoco hay, la pantalla de bundle cierra
# sola y no se redirige a ninguna parte.
BUNDLE_REDIRECT_URL=
# Opcional, sólo si quiere fijar a mano cuál es SU equipo de bundle (el que ya tiene sus cuentas):
#   BUNDLE_NEGOCIO_DUENO = el id del negocio dueño (el de su cuenta en Sinkroo)
#   BUNDLE_TEAM_DUENO    = el id del equipo de bundle que le corresponde (si se deja vacío, el más antiguo)
# Normalmente NO hacen falta: el servidor reconoce su equipo porque lo creó el correo de su usuario en
# bundle.social. Se declaran sólo si quiere forzar otro equipo.
BUNDLE_NEGOCIO_DUENO=
BUNDLE_TEAM_DUENO=
